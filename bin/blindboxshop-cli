const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('blindboxshop-cli v1.0.0 (https://blindboxshop.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'blindboxshop.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'blindboxshop.com', benchmark: "Chase Figure Pull Probability & Sealed Case Statistical Reference", rows: SPECS }, null, 2));
  process.exit(0);
}

